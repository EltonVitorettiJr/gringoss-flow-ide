# Deixe VITE_API_URL vazio para rodar só com dados locais (localStorage).
# Com a API rodando em localhost:3000, use:
VITE_API_URL=http://localhost:3000
# Mesmo valor do API_KEY no .env da API (necessário para POST/PUT/DELETE).
# Atenção: variáveis VITE_* ficam visíveis no navegador. Serve para o projeto acadêmico, não para produção.
VITE_API_KEY=gringoss_flow_ide_2026
